# Copy this to .env and edit before running.

# REQUIRED: generate with `python3 -c "import secrets; print(secrets.token_hex(32))"`
# Used for JWT signing AND for deriving the key that encrypts stored
# credentials (SSH pivot keys, SNMP community strings, etc.) at rest.
# Changing this after credentials have been stored will make them
# undecryptable — rotate deliberately, not accidentally.
SECRET_KEY=CHANGE-ME-generate-a-real-random-secret-before-deploying

# Defaults to a local SQLite file if unset — zero extra services needed.
# For Postgres: postgresql+psycopg://user:password@host:5432/dbname
# DATABASE_URL=sqlite:///./data/pretweb.db

# LAN-only bind address. Do NOT set to 0.0.0.0 on any host with a public
# or WAN-facing interface. See pret-web-ui-docs/05-SECURITY-ARCHITECTURE.md.
BIND_HOST=0.0.0.0
BIND_PORT=8443

# First-run only: sets the bootstrap admin account's password. If unset,
# the app falls back to an insecure default and prints a loud warning.
PRETWEB_ADMIN_USER=admin
PRETWEB_ADMIN_PASSWORD=choose-a-real-password-before-first-run
